# --- Mode 1: AI dari browser (disarankan) ---
# Buka aplikasi > tombol "Pengaturan AI" di navbar > pilih provider > tempel API key.
# Key disimpan di localStorage browser, tidak perlu build ulang.

# --- Mode 2: AI lewat proxy serverless (Vercel) ---
# Isi di Vercel > Settings > Environment Variables (JANGAN pakai prefix REACT_APP_).
#   LLM_API_KEY=kn-xxxxxxxx
#   LLM_BASE_URL=https://kenari.id/v1
#   LLM_MODEL=glm-4-7-flash:free

# --- Mode 3: build-time (dev lokal saja, key ikut ke bundle) ---
# Kosongkan REACT_APP_LLM_API_KEY untuk memakai mode aturan lokal.
REACT_APP_LLM_API_KEY=
REACT_APP_LLM_BASE_URL=https://kenari.id/v1
REACT_APP_LLM_MODEL=glm-4-7-flash:free

# Contoh provider lain (semua OpenAI-compatible):
# Kenari.id   : https://kenari.id/v1
# OpenRouter  : https://openrouter.ai/api/v1
# Groq        : https://api.groq.com/openai/v1
# OpenAI      : https://api.openai.com/v1
# Together    : https://api.together.xyz/v1
# Ollama lokal: http://localhost:11434/v1  (key: ollama)
