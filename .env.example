# Kosongkan REACT_APP_LLM_API_KEY untuk memakai mode aturan lokal (tanpa API).
# Isi untuk mengaktifkan klasifikasi LLM. Semua provider OpenAI-compatible didukung.

REACT_APP_LLM_API_KEY=
REACT_APP_LLM_BASE_URL=https://api.openai.com/v1
REACT_APP_LLM_MODEL=gpt-4o-mini

# Contoh provider lain:
# Kenari.id   : REACT_APP_LLM_BASE_URL=https://api.kenari.id/v1
# OpenRouter  : REACT_APP_LLM_BASE_URL=https://openrouter.ai/api/v1
# Groq        : REACT_APP_LLM_BASE_URL=https://api.groq.com/openai/v1
# Ollama lokal: REACT_APP_LLM_BASE_URL=http://localhost:11434/v1  (key: ollama)
